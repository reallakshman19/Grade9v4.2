{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./web/*"]
    }
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.d.ts",
    "tests/browser/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
