      "subject_id": "PHYSICS",
      "payload": {
        "role": "A9",
        "title": "Put it together",
        "text": "Explain what is carried across a model boundary and what must be recomputed. Try the synthesis check without looking at a worked example; it does not reuse the fresh challenge.",
        "depth": "INTUITION_MODEL_FORMAL",
        "visibility": "TEACHING"
      },
