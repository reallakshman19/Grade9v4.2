      "subject_id": "PHYSICS",
      "payload": {
        "title": "When a model changes",
        "native_semantics": "DEMO ONLY",
        "reasoning_goal": "Recognize phase boundary; carry state, not vanished forces, into next model."
      },
      "dependencies": [
        {
          "type": "WARRANT",
          "id": "demo:wpe:warrant",
          "revision": 1,
          "sha256": "20bce2ca7a6da19ef3a5051d007b1d8f5cb0480f4d25dbc5ff2577b5cab6dbd0"
        },
        {
          "type": "QUESTION",
          "id": "demo:wpe:source",
          "revision": 1,
