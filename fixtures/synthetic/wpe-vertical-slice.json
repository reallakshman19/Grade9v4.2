    {
      "schema_version": "engineering-projection/1",
      "type": "PRESENTATION",
      "id": "demo:wpe:a7",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "role": "A7",
        "title": "Find the first wrong idea",
        "text": "A learner keeps drawing a spring force after separation. The first wrong idea is treating loss of contact as irrelevant. Erase that force from the second-region force diagram before choosing a new equation.",
        "depth": "INTUITION_MODEL_FORMAL",
        "visibility": "TEACHING"
      },
      "dependencies": [
        {
          "type": "WARRANT",
          "id": "demo:wpe:warrant",
          "revision": 1,
          "sha256": "20bce2ca7a6da19ef3a5051d007b1d8f5cb0480f4d25dbc5ff2577b5cab6dbd0"
        }
