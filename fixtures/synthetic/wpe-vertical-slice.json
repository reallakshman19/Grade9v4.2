    {
      "schema_version": "engineering-projection/1",
      "type": "FRESH_TASK",
      "id": "demo:wpe:fresh",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "stem": "A 0.8 kg cart starts at rest against an unattached ideal spring of stiffness 160 N/m compressed 0.15 m. The horizontal track is smooth while the spring pushes. After it leaves the spring, a braking strip exerts a constant 3 N force opposite motion over 0.40 m. Does the cart emerge from the strip? If so, find its speed. Explain your model and show your work.",
        "fields": [
          {
            "id": "response",
            "kind": "CONSTRUCTED_RESPONSE",
            "required": true,
            "prompt": "Explain your reasoning"
          },
          {
            "id": "work",
            "kind": "CONSTRUCTED_RESPONSE",
            "required": true,
            "prompt": "Show your calculations or drawing"
          }
        ],
        "prediction_prompt": "Describe what you expect to happen before calculating.",
        "visibility": "ATTEMPT"
      },
      "dependencies": [
        {
          "type": "CONSTRUCTION",
          "id": "demo:wpe:construction",
          "revision": 1,
          "sha256": "dc3e00811e9499bc6793404b27a3538edac447c0170a1b12eabc7d5339481769"
        },
        {
          "type": "WARRANT",
          "id": "demo:wpe:warrant",
          "revision": 1,
          "sha256": "20bce2ca7a6da19ef3a5051d007b1d8f5cb0480f4d25dbc5ff2577b5cab6dbd0"
        }
      ],
      "source_lineage_refs": [],
      "status": "SYNTHETIC"
    },
    {
      "schema_version": "engineering-projection/1",
      "type": "SOLUTION",
      "id": "demo:wpe:fresh-solution",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "visibility": "AFTER_FIRST_COMMIT",
        "steps": [
          "Spring energy = 0.5×160×0.15² = 1.8 J. Smooth contact ends at natural length.",
          "Release kinetic energy 1.8 J.",
          "Braking strip removes 3×0.40 = 1.2 J.",
          "Remaining energy 0.6 J; cart emerges with v=√(2×0.6/0.8)=√1.5 m/s ≈1.225 m/s."
        ],
        "rubric": [
          "Choose two regions and correct contact boundary",
          "Use spring energy only during contact",
          "Compute negative braking work only on strip",
          "Check feasibility before square root",
          "Explain why the force model changes"
        ],
        "diagnosis": [
          "Continuing spring work",
          "Applying brake work in smooth region",
          "Ignoring stop condition"
        ],
        "repair_prompt": "Redraw the force model for the region where your reasoning first diverged. Keep your original and revise separately."
      },
