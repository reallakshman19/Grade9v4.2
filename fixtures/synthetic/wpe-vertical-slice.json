  "objects": [
    {
      "schema_version": "engineering-projection/1",
      "type": "WARRANT",
      "id": "demo:wpe:warrant",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "law": "Work–energy theorem, Hooke spring and contact boundary",
        "conditions": [
          "ideal linear massless spring",
          "unattached cart: contact is push only",
          "horizontal track",
          "neglect drag",
          "friction only where specified"
        ],
        "relations": [
          "Us = kx²/2",
          "Kf = Ki + Wnet",
          "Wf = −fd for constant opposing friction"
        ],
        "independent_check": "Units: N/m × m² = N m = J; energy ledger changes only when forces transfer energy."
      },
      "dependencies": [],
      "source_lineage_refs": [],
      "status": "SYNTHETIC"
    },
    {
      "schema_version": "engineering-projection/1",
      "type": "QUESTION",
      "id": "demo:wpe:source",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "title": "A synthetic spring launch question",
        "stem": "A 1 kg cart, not attached to a spring, leaves it at natural length with 4 J kinetic energy. The track then slopes upward. Ignore friction. What maximum vertical rise can it reach? Take g = 10 m/s². Explain which force acts after separation.",
        "response_kind": "CONSTRUCTED_RESPONSE",
        "source_role": "SYNTHETIC_NO_EXAM_CLAIM"
      },
      "dependencies": [
        {
          "type": "WARRANT",
          "id": "demo:wpe:warrant",
          "revision": 1,
          "sha256": "20bce2ca7a6da19ef3a5051d007b1d8f5cb0480f4d25dbc5ff2577b5cab6dbd0"
        }
      ],
      "source_lineage_refs": [],
      "status": "SYNTHETIC"
    },
    {
      "schema_version": "engineering-projection/1",
      "type": "SOLUTION",
      "id": "demo:wpe:source-solution",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "text": "After release, no spring force; 4 J = mgh gives h=0.4 m. Gravity transfers kinetic to gravitational potential energy."
      },
      "dependencies": [
        {
          "type": "QUESTION",
          "id": "demo:wpe:source",
