    {
      "schema_version": "engineering-projection/1",
      "type": "PRESENTATION",
      "id": "demo:wpe:a8",
      "revision": 1,
      "subject_id": "PHYSICS",
      "payload": {
        "role": "A8",
        "title": "When does the rule change?",
        "text": "If the cart is attached, the spring can pull as well as push. The natural-length point is not automatically a force-law termination: beyond it the spring stretches and pulls back. If friction acts during contact, its work belongs in the contact ledger.",
        "depth": "INTUITION_MODEL_FORMAL",
        "visibility": "TEACHING"
      },
      "dependencies": [
        {
          "type": "WARRANT",
          "id": "demo:wpe:warrant",
          "revision": 1,
          "sha256": "20bce2ca7a6da19ef3a5051d007b1d8f5cb0480f4d25dbc5ff2577b5cab6dbd0"
        }
      ],
      "source_lineage_refs": [],
      "status": "SYNTHETIC"
    },
