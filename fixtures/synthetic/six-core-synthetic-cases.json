      "subject": "PHYSICS",
      "payload": {
        "construction_id": "demo:c:construction",
        "worked_steps": [
          "Identify initial kinetic energy: E_k = 0.5 * m * v^2",
          "Identify maximum potential energy at stop: E_p = 0.5 * k * x_max^2",
          "Equate energies by work-energy theorem: 0.5 * m * v^2 = 0.5 * k * x_max^2",
          "Solve for maximum compression: x_max = v * sqrt(m / k)"
        ],
        "common_trap_repair": "An unattached spring can push during rebound until natural length, then cannot pull after separation.",
        "inferential_jump": "Use the current contact region to decide which interactions belong in the energy ledger."
      }
