  "interaction_and_device_contracts": {
    "touchscreen_12_7_inch": {
      "reference_viewports": [
        [1000, 1600],
        [1600, 1000],
        [800, 1280],
        [1280, 800],
        [854, 1366],
        [1366, 854],
        [390, 844]
      ],
      "touch_hitbox_min_px": 48,
      "primary_action_height_min_px": 56,
      "control_gap_min_px": 8,
      "pointer_events": {
        "pointer_types": ["touch", "pen", "mouse"],
        "pointer_capture": "REQUIRED_DURING_DRAWING",
        "pointer_cancel": "HANDLED_PRESERVE_COMPLETED_STROKES",
        "pressure_sensitivity": "OPTIONAL_FALLBACK_TO_FIXED_WIDTH"
      },
      "viewport_handling": {
        "unit": "dvh_with_fallback",
        "software_keyboard": "MUST_NOT_OBSCURE_FOCUSED_INPUT_OR_SUBMIT",
        "scrolling": "ALWAYS_PERMITTED_OUTSIDE_CANVAS",
        "horizontal_page_scroll": "PROHIBITED"
      },
      "layout_adaptations": {
        "portrait": "SINGLE_COLUMN_BOTTOM_NAV_SUPPORT_DRAWER",
        "landscape_gte_1100": "TWO_PANE_SPLIT_44_56_COLLAPSIBLE_NAV",
        "split_resizing": "KEYBOARD_ACCESSIBLE_BUTTONS_NOT_DRAG_ONLY"
      }
    },
    "child_friendly_text_and_search": {
      "text_invariants": {
        "official_content": "PRESERVED_VERBATIM_NO_SILENT_PARAPHRASE",
        "child_friendly_prose": "SEPARATELY_VERSIONED_LOCALE_DICTIONARY",
        "cognitive_vocabulary": "EXPLAINED_NOT_REMOVED",
        "unsupported_feedback": "NO_FAKE_PRAISE_OR_BLAME",
        "answer_leakage": "STRICTLY_PROHIBITED_BEFORE_SUBMISSION"
      },
      "search_invariants": {
        "index_source": "RELEASED_GRAPH_ONLY",
        "withholding": "NO_SOLUTIONS_HINTS_ANSWERS_OR_PRIVATE_NOTES",
        "scoring": "EXACT_ID_BOOST_TITLE_WEIGHT_5_CONCEPT_3_SUMMARY_1",
        "normalization": "UNICODE_NFKC_CASEFOLD"
      }
