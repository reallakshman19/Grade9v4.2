{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "g9-ui-screen-contracts/1.0",
  "workpack_id": "A61",
  "title": "Platform UI Screen Trees, Action Contracts, and Responsive Interaction Specifications",
  "status": "PROPOSED_PENDING_INDEPENDENT_REVIEW",
  "created_at": "2026-11-17T08:35:00Z",
  "routing_policy": "Static base-aware generated entrypoints or hash router with stable legacy query mapping. No reliance on SPA server fallback.",
  "required_common_states": [
    "loading",
    "error",
    "populated",
    "keyboard",
    "touch",
    "portrait",
    "landscape",
    "refresh"
