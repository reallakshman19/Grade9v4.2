{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:g9:engineering:response:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "value"
  ],
  "properties": {
    "kind": {
      "enum": [
        "SINGLE_CHOICE",
        "MULTIPLE_CHOICE",
        "INTEGER",
        "NUMERIC_QUANTITY",
        "SYMBOLIC_EXPRESSION",
        "CONSTRUCTED_RESPONSE",
        "MATHEMATICAL_PROOF",
        "CHEMICAL_STRUCTURE",
        "REACTION_MECHANISM",
        "DATA_TABLE",
        "GRAPH",
        "EXPERIMENT_ANALYSIS",
        "MULTIPART"
      ]
    },
    "value": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SINGLE_CHOICE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MULTIPLE_CHOICE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "INTEGER"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "NUMERIC_QUANTITY"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decimal",
              "unit"
            ],
            "properties": {
              "decimal": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SYMBOLIC_EXPRESSION"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CONSTRUCTED_RESPONSE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MATHEMATICAL_PROOF"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CHEMICAL_STRUCTURE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "format",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "REACTION_MECHANISM"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "DATA_TABLE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "GRAPH"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "points"
            ],
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EXPERIMENT_ANALYSIS"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "observations",
              "conclusion"
            ],
            "properties": {
              "observations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "conclusion": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MULTIPART"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#"
            }
          }
        }
      }
    }
  ]
}
