{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:g9:engineering:exam-profile:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "programme_id",
    "subject_ids",
    "stage",
    "synthetic",
    "capabilities",
    "policy",
    "task_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "programme_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PHYSICS",
          "CHEMISTRY",
          "MATHEMATICS",
          "BIOLOGY"
        ]
      }
    },
    "stage": {
      "enum": [
        "E1",
        "E2",
        "E3",
        "FOUNDATION"
      ]
    },
    "synthetic": {
      "const": true
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "SINGLE_CHOICE",
          "MULTIPLE_CHOICE",
          "INTEGER",
          "NUMERIC_QUANTITY",
          "SYMBOLIC_EXPRESSION",
          "CONSTRUCTED_RESPONSE",
          "MATHEMATICAL_PROOF",
          "CHEMICAL_STRUCTURE",
          "REACTION_MECHANISM",
          "DATA_TABLE",
          "GRAPH",
          "EXPERIMENT_ANALYSIS",
          "MULTIPART"
        ]
      }
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_points",
        "duration_seconds",
        "aids",
        "allow_hints"
      ],
      "properties": {
        "mode": {
          "enum": [
            "PRACTICE",
            "SIMULATED_EXAM"
          ]
        },
        "max_points": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "aids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_hints": {
          "type": "boolean"
        }
      }
    }
  }
}
