{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:g9:engineering:programme:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "subject_ids",
    "stages",
    "curriculum_framework",
    "synthetic",
    "policy",
    "status",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PHYSICS",
          "CHEMISTRY",
          "MATHEMATICS",
          "BIOLOGY"
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "E1",
          "E2",
          "E3",
          "FOUNDATION"
        ]
      }
    },
    "curriculum_framework": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "allow_hints",
        "calculator_allowed"
      ],
      "properties": {
        "default_mode": {
          "enum": [
            "PRACTICE",
            "SIMULATED_EXAM"
          ]
        },
        "allow_hints": {
          "type": "boolean"
        },
        "calculator_allowed": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "enum": [
        "SYNTHETIC",
        "HOLD",
        "PROPOSED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
