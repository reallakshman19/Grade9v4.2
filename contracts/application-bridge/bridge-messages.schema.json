{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grade9 Isolated Application Bridge Message Schema",
  "description": "Governs postMessage communication between isolated application iframes and the host shell.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "READY",
        "STATE_SNAPSHOT",
        "OBSERVATION",
        "NAVIGATE_REQUEST",
        "EXIT_REQUEST",
        "ERROR"
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32,64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{16,64}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "nonce",
    "sequence",
    "resource_id",
    "revision",
    "session_id",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bridge_version": {
                "const": "1.0.0"
              },
              "capabilities_ready": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "bridge_version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STATE_SNAPSHOT"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state_version": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "object",
                "propertyNames": {
                  "not": {
                    "enum": [
                      "learner_attempts",
                      "evaluation_scores",
                      "topic_mastery",
                      "academic_governance",
                      "release_authority"
                    ]
                  }
                },
                "additionalProperties": {
                  "$ref": "#/$defs/safeStateValue"
                }
              }
            },
            "required": [
              "state_version",
              "state"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "OBSERVATION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            },
            "required": [
              "capability_id",
              "value"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "NAVIGATE_REQUEST"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_resource_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.:-]+$"
              }
            },
            "required": [
              "target_resource_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "EXIT_REQUEST"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "safeStateValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safeStateValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "learner_attempts",
                "evaluation_scores",
                "topic_mastery",
                "academic_governance",
                "release_authority"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/safeStateValue"
          }
        }
      ]
    }
  }
}
